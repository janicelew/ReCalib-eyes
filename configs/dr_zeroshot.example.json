{
  "eyeclip_repo": "/Users/lewjanice/Documents/EyeCLIP",
  "checkpoint": "/Users/lewjanice/Documents/EyeCLIP/eyeclip_visual.pt",
  "device": "auto",
  "batch_size": 8,
  "num_workers": 0,
  "output_dir": "outputs/zeroshot_dr",
  "score_mode": "grade_sum",
  "target_specificity": 0.9,
  "source_calibration": {
    "enabled": true,
    "source_roles": ["source"],
    "threshold_metric": "balanced_accuracy",
    "fit_probability_calibrator": true
  },
  "datasets": [
    {
      "name": "APTOS2019",
      "role": "source",
      "csv_path": "data/aptos2019/train.csv",
      "image_dir": "data/aptos2019/train_images",
      "id_col": "id_code",
      "grade_col": "diagnosis",
      "preferred_ext": ".png"
    },
    {
      "name": "IDRiD",
      "role": "target",
      "csv_path": "data/idrid/labels.csv",
      "image_dir": "data/idrid/images",
      "id_col": "image_id",
      "grade_col": "grade",
      "preferred_ext": ".jpg"
    },
    {
      "name": "MESSIDOR2",
      "role": "target",
      "csv_path": "data/messidor2/labels.csv",
      "image_dir": "data/messidor2/images",
      "id_col": "image_id",
      "grade_col": "grade",
      "preferred_ext": ".jpg"
    }
  ],
  "prompts_by_grade": {
    "grade_0_normal": [
      "normal",
      "color fundus, normal retina",
      "fundus photography, no diabetic retinopathy"
    ],
    "grade_1_mild": [
      "mild diabetic retinopathy",
      "color fundus, mild diabetic retinopathy",
      "fundus photography, mild nonproliferative diabetic retinopathy"
    ],
    "grade_2_moderate": [
      "moderate diabetic retinopathy",
      "color fundus, moderate diabetic retinopathy",
      "fundus photography, moderate nonproliferative diabetic retinopathy"
    ],
    "grade_3_severe": [
      "severe diabetic retinopathy",
      "color fundus, severe diabetic retinopathy",
      "fundus photography, severe nonproliferative diabetic retinopathy"
    ],
    "grade_4_proliferative": [
      "proliferative diabetic retinopathy",
      "color fundus, proliferative diabetic retinopathy",
      "fundus photography, proliferative diabetic retinopathy"
    ]
  }
}
